# ==============================================================================
# ShopEasy Client Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. In local development, copy this to '.env' (optional, defaults to http://localhost:5000/api)
# 2. In Vercel / Cloud deployment, set VITE_API_URL to your deployed Render backend API URL.
#    Example: https://shopeasy-backend.onrender.com/api
# ==============================================================================

# Backend API Base URL (Points to the Express API /api endpoint)
VITE_API_URL=http://localhost:5000/api
