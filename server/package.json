{
  "name": "shopeasy-server",
  "version": "1.0.0",
  "description": "ShopEasy Backend REST API",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test --test-concurrency=1 tests/**/*.test.js",
    "seed": "node src/scripts/seedDatabase.js",
    "seed:products": "node src/scripts/seedProducts.js",
