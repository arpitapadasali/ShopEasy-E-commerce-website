  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.0",
    "nodemailer": "^10.1.7",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "morgan": "^1.10.0",
    "nodemon": "^3.1.9"
  }
